# ── App ──────────────────────────────────────────────
# Single-user auth token. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=change-me
CONNECTOR_SECRET=use-a-different-persistent-random-value
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Optional native Gemini route (legacy environment names) ──
AGENTROUTER_BASE_URL=
AGENTROUTER_API_KEY=
AGENTROUTER_DEFAULT_MODEL=gemini-3.8-flash

# ── LLM (secondary provider, routed by model name) ───
BAI_BASE_URL=https://api.b.ai/v1
BAI_API_KEY=

# ── Database ─────────────────────────────────────────
# Dev default: sqlite+aiosqlite:///./app.db
# Prod (Neon): postgresql+asyncpg://user:pass@host/dbname?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ── E2B sandboxes ────────────────────────────────────
E2B_API_KEY=
# The free cloud runner uses Docker workspaces instead of E2B.
SANDBOX_BACKEND=e2b
DOCKER_SANDBOX_IMAGE=cockpit-sandbox:local
BACKGROUND_WORKER_ENABLED=true
# Sandbox lifetime in seconds (auto-extended on every agent iteration).
SANDBOX_TIMEOUT_S=3600

# ── GitHub (injected into sandboxes; gh + git) ───────
# Needs repo contents:write to open PRs. For `deploy_site` persistence,
# also grant Pages:write (or enable Pages once in the target repo settings).
GITHUB_PAT=

# ── Web Push (VAPID) ─────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Server ───────────────────────────────────────────
# Hugging Face Spaces sets PORT=7860
PORT=8000
# Public origin used for deploy_site fallback links (Render sets
# RENDER_EXTERNAL_URL automatically).
PUBLIC_BASE_URL=
# How many tasks the background worker runs at once.
WORKER_CONCURRENCY=3
# Maximum queued, running, or approval-waiting tasks. Must be a positive integer.
MAX_ACTIVE_TASKS=1
# Maximum wall-clock runtime for a task's complete execution lifecycle. Must be positive.
MAX_TASK_RUNTIME_S=1800
# Maximum persisted events retained per task. Must be a positive integer.
MAX_EVENTS_PER_TASK=1000
SANDBOX_IDLE_TIMEOUT_S=900
SANDBOX_CLEANUP_INTERVAL_S=60

# ── Free generation and optional GPT-6.1 Sol ─────────
# Install: npm install --global opencode-ai@1.19.5
OPENCODE_BIN=opencode
OPENCODE_TIMEOUT_S=240
# Set remote-worker flags on the API host for the scheduled Actions deployment.
OPENCODE_REMOTE_WORKER=false
LOCAL_LLM_REMOTE_WORKER=false
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:1.7b
# Optional; no endpoint or key is bundled. Select explicitly to use this route.
XINGCHI_BASE_URL=
XINGCHI_API_KEY=
XINGCHI_API_STYLE=responses
AGENTROUTER_OPENAI_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_OPENAI_API_KEY=
FREEGG_BASE_URL=https://freegg.app/v1
FREEGG_API_KEY=
OPENCODE_API_KEY=

# ── YouTube automation ──────────────────────────────
AUTOMATION_ENABLED=true
AUTOMATION_STORAGE_DIR=data/automation
AUTOMATION_STORAGE_PERSISTENT=false
AUTOMATION_YOUTUBE_CLIENT_ID=
AUTOMATION_YOUTUBE_CLIENT_SECRET=
AUTOMATION_YOUTUBE_REDIRECT_URI=
AUTOMATION_FRONTEND_URL=
AUTOMATION_S3_ENDPOINT=
AUTOMATION_S3_ACCESS_KEY=
AUTOMATION_S3_SECRET_KEY=
AUTOMATION_S3_BUCKET=
AUTOMATION_S3_REGION=us-east-1
AUTOMATION_MEDIA_RETENTION_DAYS=7
AUTOMATION_MEDIA_STORAGE_LIMIT_MB=750
# Optional fine-grained Actions:write token for Run now / Approve / Retry.
AUTOMATION_GITHUB_REPOSITORY=
AUTOMATION_GITHUB_TOKEN=
AUTOMATION_GITHUB_REF=main
# Disable self-pinging on sleeping API deployments.
KEEPALIVE_ENABLED=false
