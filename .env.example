# ── App ──────────────────────────────────────────────
# Single-user auth token. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=change-me

# ── LLM (agentrouter, OpenAI-compatible) ─────────────
AGENTROUTER_BASE_URL=https://your-proxy.example.com/v1
AGENTROUTER_API_KEY=sk-...
AGENTROUTER_DEFAULT_MODEL=your-default-model-id

# ── Database ─────────────────────────────────────────
# Dev default: sqlite+aiosqlite:///./app.db
# Prod (Neon): postgresql+asyncpg://user:pass@host/dbname?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ── E2B sandboxes ────────────────────────────────────
E2B_API_KEY=
# Sandbox lifetime in seconds (auto-extended on every agent iteration).
SANDBOX_TIMEOUT_S=3600

# ── GitHub (injected into sandboxes; gh + git) ───────
GITHUB_PAT=

# ── Web Push (VAPID) ─────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Server ───────────────────────────────────────────
# Hugging Face Spaces sets PORT=7860
PORT=8000
